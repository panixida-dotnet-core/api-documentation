<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>

        <AssemblyName>PANiXiDA.Core.ApiDocumentation</AssemblyName>

        <PackageId>PANiXiDA.Core.ApiDocumentation</PackageId>
        <Description>Renderer-independent API document contracts and AOT-compatible AsyncAPI generation.</Description>
        <PackageTags>PANiXiDA;Core;AsyncAPI;OpenAPI;Documentation;NativeAOT</PackageTags>

        <RepositoryUrl>https://github.com/panixida-dotnet-core/api-documentation</RepositoryUrl>
        <PackageProjectUrl>https://github.com/panixida-dotnet-core/api-documentation</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
</Project>
